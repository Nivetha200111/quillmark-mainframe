                                                                        00007900
      * SIMPLE DAILY INTEREST, ACTUAL/365. CREDIT BALANCES EARN THE     00008000
      * ACCOUNT RATE; OVERDRAWN BALANCES ARE CHARGED RATE + PENALTY.    00008100
       3000-CALC-INTEREST.                                              00008200
           EVALUATE TRUE                                                00008300
               WHEN ACCT-BALANCE > ZERO                                 00008400
                   COMPUTE WS-INTEREST ROUNDED =                        00008500
                       ACCT-BALANCE * ACCT-RATE * ACCT-DAYS / 365       00008600
               WHEN ACCT-BALANCE < ZERO                                 00008700
                   COMPUTE WS-INTEREST ROUNDED =                        00008800
                       ACCT-BALANCE * (ACCT-RATE + WS-PENALTY-RATE)     00008900
                       * ACCT-DAYS / 365                                00009000
               WHEN OTHER                                               00009100
                   MOVE ZERO TO WS-INTEREST                             00009200
           END-EVALUATE.                                                00009300
                                                                        00009400
      * MAINTENANCE FEE: 0.15 PERCENT OF THE SHORTFALL BELOW THE FLOOR, 00009500
      * TRUNCATED TO THE CENT, CAPPED. PREMIUM TIER IS WAIVED.          00009600
       4000-CALC-FEE.                                                   00009700
           MOVE ZERO TO WS-FEE                                          00009800
           IF NOT ACCT-TIER-PREMIUM                                     00009900
              AND ACCT-BALANCE < WS-FEE-FLOOR                           00010000
               COMPUTE WS-FEE =                                         00010100
                   (WS-FEE-FLOOR - ACCT-BALANCE) * 0.0015               00010200
               IF WS-FEE > WS-FEE-CAP                                   00010300
                   MOVE WS-FEE-CAP TO WS-FEE                            00010400
               END-IF                                                   00010500
           END-IF.                                                      00010600
                                                                        00010700
       5000-WRITE-RESULT.                                               00010800
           COMPUTE WS-NEW-BAL = ACCT-BALANCE + WS-INTEREST - WS-FEE     00010900
           MOVE ACCT-ID     TO OUT-ACCT-ID                              00011000
           MOVE WS-INTEREST TO OUT-INTEREST                             00011100
           MOVE WS-FEE      TO OUT-FEE                                  00011200
           MOVE WS-NEW-BAL  TO OUT-NEW-BAL                              00011300
           EVALUATE TRUE                                                00011400
               WHEN WS-NEW-BAL < ZERO                                   00011500
                   MOVE 'OD' TO OUT-STATUS                              00011600
               WHEN WS-FEE > ZERO                                       00011700
                   MOVE 'FE' TO OUT-STATUS                              00011800
               WHEN OTHER                                               00011900
                   MOVE 'OK' TO OUT-STATUS                              00012000
           END-EVALUATE                                                 00012100
           WRITE OUT-REC                                                00012200
           ADD 1 TO WS-WRITE-CNT.                                       00012300
                                                                        00012400
       8000-READ.                                                       00012500
           READ ACCT-FILE                                               00012600
               AT END                                                   00012700
                   SET END-OF-ACCOUNTS TO TRUE                          00012800
           END-READ.                                                    00012900
                                                                        00013000
       9000-TERM.                                                       00013100
           CLOSE ACCT-FILE OUT-FILE                                     00013200
           DISPLAY 'INTACCR READ=' WS-READ-CNT ' WRITTEN=' WS-WRITE-CNT.00013300
