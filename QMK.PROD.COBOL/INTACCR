               ORGANIZATION IS SEQUENTIAL                               00002100
               FILE STATUS IS WS-OUT-STATUS.                            00002200
       DATA DIVISION.                                                   00002300
       FILE SECTION.                                                    00002400
       FD  ACCT-FILE                                                    00002500
           RECORDING MODE IS F                                          00002600
           BLOCK CONTAINS 0 RECORDS                                     00002700
           LABEL RECORDS ARE STANDARD.                                  00002800
       COPY ACCTREC.                                                    00002900
       FD  OUT-FILE                                                     00003000
           RECORDING MODE IS F                                          00003100
           BLOCK CONTAINS 0 RECORDS                                     00003200
           LABEL RECORDS ARE STANDARD.                                  00003300
       COPY INTREC.                                                     00003400
       WORKING-STORAGE SECTION.                                         00003500
       01  WS-ACCT-STATUS              PIC XX.                          00003600
       01  WS-OUT-STATUS               PIC XX.                          00003700
       01  WS-EOF-FLAG                 PIC X VALUE 'N'.                 00003800
           88  END-OF-ACCOUNTS         VALUE 'Y'.                       00003900
       01  WS-PENALTY-RATE             PIC 9V9(4) VALUE 0.0500.         00004000
       01  WS-FEE-FLOOR                PIC S9(5)V99 COMP-3              00004100
                                       VALUE 1000.00.                   00004200
       01  WS-FEE-CAP                  PIC S9(5)V99 COMP-3              00004300
                                       VALUE 25.00.                     00004400
       01  WS-INTEREST                 PIC S9(7)V99 COMP-3.             00004500
       01  WS-FEE                      PIC S9(5)V99 COMP-3.             00004600
       01  WS-NEW-BAL                  PIC S9(9)V99 COMP-3.             00004700
       01  WS-COUNTERS.                                                 00004800
           05  WS-READ-CNT             PIC 9(7) COMP VALUE 0.           00004900
           05  WS-WRITE-CNT            PIC 9(7) COMP VALUE 0.           00005000
       PROCEDURE DIVISION.                                              00005100
       0000-MAIN.                                                       00005200
           PERFORM 1000-INIT                                            00005300
